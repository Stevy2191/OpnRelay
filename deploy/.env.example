# Hostname users will open, e.g. guides.company.local
OPNRELAY_DOMAIN=guides.company.local
# "internal" for an internal-only name (Caddy local CA), or an email address
# for automatic Let's Encrypt certificates on a public DNS name.
OPNRELAY_TLS=internal
# Image tag to run (see GitHub releases).
OPNRELAY_VERSION=latest
OPNRELAY_MAX_UPLOAD_MB=50
