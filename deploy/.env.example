# Which files make up the stack (written by the installer):
#   HTTPS with Caddy:       COMPOSE_FILE=compose.yaml:compose.caddy.yaml
#   Own proxy / HTTP test:  COMPOSE_FILE=compose.yaml:compose.port.yaml
COMPOSE_FILE=compose.yaml:compose.caddy.yaml

# Address people open, e.g. https://guides.company.local (http:// only for testing).
OPNRELAY_PUBLIC_URL=https://guides.company.local

# Caddy mode only: hostname and certificate source ("internal" CA, or an email
# address for automatic Let's Encrypt certificates on a public DNS name).
OPNRELAY_DOMAIN=guides.company.local
OPNRELAY_TLS=internal

# Own-proxy / HTTP mode only: where the server port is published.
#   own proxy on this machine: 127.0.0.1:8080   HTTP testing: 0.0.0.0:8080
OPNRELAY_HTTP_BIND=127.0.0.1:8080
# Trust X-Forwarded-For from the proxy (false for plain HTTP testing).
OPNRELAY_TRUST_PROXY=true

OPNRELAY_VERSION=latest
OPNRELAY_MAX_UPLOAD_MB=50
